# Copy this file to backend/.env (the copy is ignored by git) and fill in your own values.
# NEVER commit the real .env or share it: it contains secret keys.

# Gemini key from https://aistudio.google.com/apikey  (optional: without it, tone/claims use built-in rules)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Database. Leave MONGO_URI as is for a local MongoDB, or paste your MongoDB Atlas connection string.
# If MongoDB is not reachable the backend automatically uses an in-memory database (data resets on restart).
MONGO_URI=mongodb://localhost:27017
DB_NAME=brandlens
# USE_MEMORY_DB=1

# Secret used to sign login tokens. CHANGE THIS when deploying (any long random text).
JWT_SECRET=change-me-to-a-long-random-text

# Address of the website allowed to call this API (comma-separate several). Use your real site when deployed.
FRONTEND_URL=http://localhost:3000
