# ==========================================
# BrandLens Environment Variables
# ==========================================

# ---- AI (Google Gemini) ----
# Obtain from https://aistudio.google.com/apikey
# Optional: if omitted, rule-based fallback checkers run automatically
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Database (MongoDB) ----
# For local development: mongodb://localhost:27017
# For cloud deployment: MongoDB Atlas connection string (mongodb+srv://...)
# If offline/unreachable, BrandLens automatically falls back to in-memory mongomock
MONGO_URI=mongodb://localhost:27017
DB_NAME=brandlens
# Set to 1 to force in-memory mock database
# USE_MEMORY_DB=1

# ---- Authentication & Security ----
# Secret key used to sign JWT tokens. Change to a long random secret in production!
JWT_SECRET=dev-secret-key-change-in-production
JWT_HOURS=12

# ---- CORS & URLs ----
# Allowed frontend URL(s) for backend CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000

# Frontend API target (used by Next.js frontend in .env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
